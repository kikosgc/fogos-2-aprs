# fogos-2-aprs — environment variable template
# Copy this file to .env and fill in your actual values.
# .env is excluded from version control via .gitignore.

# Your APRS-IS callsign (e.g. CT7AJM-5)
APRS_CALLSIGN=CALLSIGN

# Your APRS-IS password (generated from your callsign)
APRS_PASSWORD=PASSWORD

# Incident nature filter — only incidents of this type are forwarded.
# Set to empty string to forward ALL incident types.
# Default: Mato (wildland/scrub fires)
NATUREZA_FILTER=Mato

# Position beacon coordinates (APRS format: DDmm.mmH)
# Default: ANEPC headquarters in Carnaxide, Portugal
POSITION_LAT=3843.23N
POSITION_LON=00914.18W
POSITION_COMMENT=ANEPC - Autoridade Nacional de Emergência e Proteção Civil
